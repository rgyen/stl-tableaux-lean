import STLTableaux.Closure.Residual.BranchTransitionForm

/-! # Transition forms of expansion branches

Semantic normalization for the branch shapes generated by the rules.
-/
namespace STLTableau
open scoped STL

namespace ClockResetSet

@[simp] theorem apply_union_empty_right {Clock : Type*} (Λ : ClockResetSet Clock)
    (α : ClockValuation Clock) : (Λ.union empty).apply α = Λ.apply α := by
  funext c
  simp only [apply, union, empty]
  cases Λ.value c <;> rfl

@[simp] theorem apply_union_empty_left {Clock : Type*} (Λ : ClockResetSet Clock)
    (α : ClockValuation Clock) : (empty.union Λ).apply α = Λ.apply α := rfl

/-- Nested resets overwrite outer assignments, including when the two sets
are not consistent. The inner set therefore comes first in left-biased union. -/
theorem apply_union_eq_comp {Clock : Type*} (inner outer : ClockResetSet Clock)
    (α : ClockValuation Clock) :
    (inner.union outer).apply α = inner.apply (outer.apply α) := by
  funext c
  simp only [apply, union]
  cases inner.value c <;> rfl

end ClockResetSet

namespace TransitionForm

/-- Surround a branch form with its enclosing resets. Branch forms have no
current clock constraints; nested resets retain their original precedence. -/
def underReset {Clock Var : Type*} (Λ : ClockResetSet Clock)
    (Φ : TransitionForm Clock Var) : TransitionForm Clock Var :=
  { Φ with current := { Φ.current with resets := Φ.current.resets.union Λ } }


/-- Traverse predicate invariants at the same positions and valuations as a
transition form. An absent current interval contributes no predicate tests. -/
def evaluatedInvariant {Clock Var : Type*} (Φ : TransitionForm Clock Var)
    (σ : FiniteSignal Var) (P : IntervalPartition σ.domain)
    (α : ClockValuation Clock) (k : Judgement.Position P) : Prop :=
  (∀ Ψ ∈ Φ.current.locals,
    Judgement.EvaluatedInvariant σ P (Φ.current.resets.apply α) k Ψ) ∧
  match Φ.nextPart with
  | none => True
  | some N =>
      if h : k.1 < P.size then
        ∀ Ψ ∈ N.locals, Judgement.EvaluatedInvariant σ P
          (N.resets.apply (ClockResetSet.elapse (Φ.current.resets.apply α)
            (Judgement.duration P ⟨k.1, h⟩))) ⟨k.1 + 1, by omega⟩ Ψ
      else False

/-- Normalization only rearranges current predicate occurrences. -/
theorem toTransitionForm_currentPredicates {Clock Var : Type*}
    (Ψ : Judgement Clock Var) {Φ : TransitionForm Clock Var}
    (h : toTransitionForm? Ψ = some Φ) (q : IntervalPredicate Clock Var) :
    .predicate q ∈ Φ.current.locals ↔ q ∈ Ψ.currentPredicates := by
  induction Ψ generalizing Φ with
  | terminal => cases h; simp [ofState, StateForm.ofLocal, Judgement.currentPredicates]
  | clock c r a => cases h; simp [ofState, StateForm.ofClock, Judgement.currentPredicates]
  | leftMarker m => cases h; simp [ofState, StateForm.ofLocal, Judgement.currentPredicates]
  | predicate p => cases h; simp [ofState, StateForm.ofLocal, Judgement.currentPredicates]
  | reset Λ Ψ ih =>
      cases he : toTransitionForm? Ψ with
      | none => simp [toTransitionForm?, he] at h
      | some F =>
          simp only [toTransitionForm?, he, Option.map_some, Option.some.injEq] at h
          subst Φ
          simpa only [prependReset, Judgement.currentPredicates] using ih he
  | conj Ψ Χ ihΨ ihΧ =>
      cases he : toTransitionForm? Ψ with
      | none => simp [toTransitionForm?, he] at h
      | some F =>
          cases hf : toTransitionForm? Χ with
          | none => simp [toTransitionForm?, he, hf] at h
          | some G =>
              simp [toTransitionForm?, he, hf] at h
              subst Φ
              simpa only [union, StateForm.union, Set.mem_union,
                Judgement.currentPredicates] using or_congr (ihΨ he) (ihΧ hf)
  | next Ψ ih =>
      cases he : toTransitionForm? Ψ with
      | none => simp [toTransitionForm?, he] at h
      | some F =>
          cases hn : F.nextPart with
          | some N => simp [toTransitionForm?, he, hn] at h
          | none =>
              simp [toTransitionForm?, he, hn] at h
              subst Φ
              simp [ofNextState, StateForm.empty, Judgement.currentPredicates]

end TransitionForm

namespace Judgement

theorem evaluatedInvariant_congr_of_agree {Clock Var : Type*} {Ψ : Judgement Clock Var}
    {α β : ClockValuation Clock} (h : ∀ c ∈ freeClocks Ψ, α c = β c)
    (σ : FiniteSignal Var) (P : IntervalPartition σ.domain) (k : Position P) :
    EvaluatedInvariant σ P α k Ψ ↔ EvaluatedInvariant σ P β k Ψ := by
  induction Ψ generalizing α β k with
  | terminal => rfl
  | clock c r a => rfl
  | leftMarker m => rfl
  | predicate p =>
      simp only [EvaluatedInvariant]
      split
      · exact IntervalPredicate.invariant_congr _ α β p h
      · rfl
  | next Ψ ih =>
      simp only [EvaluatedInvariant]
      split
      · apply ih
        intro c hc
        simp [ClockResetSet.elapse, h c (by simpa [freeClocks] using hc)]
      · rfl
  | reset Λ Ψ ih =>
      apply ih
      intro c hc
      cases hΛ : Λ.value c with
      | some a => simp [ClockResetSet.apply, hΛ]
      | none =>
          have hcnot : c ∉ Λ.clocks := by
            rintro ⟨a, ha⟩
            rw [hΛ] at ha
            cases ha
          have hcfree : c ∈ freeClocks (.reset Λ Ψ) := ⟨hc, hcnot⟩
          have hα : Λ.apply α c = α c := by
            unfold ClockResetSet.apply
            rw [hΛ]
          have hβ : Λ.apply β c = β c := by
            unfold ClockResetSet.apply
            rw [hΛ]
          rw [hα, hβ]
          exact h c hcfree
  | conj Φ Ψ ihΦ ihΨ =>
      constructor
      · rintro ⟨hΦ, hΨ⟩
        constructor
        · exact (ihΦ (fun c hc => h c (Or.inl hc)) k).1 hΦ
        · exact (ihΨ (fun c hc => h c (Or.inr hc)) k).1 hΨ
      · rintro ⟨hΦ, hΨ⟩
        constructor
        · exact (ihΦ (fun c hc => h c (Or.inl hc)) k).2 hΦ
        · exact (ihΨ (fun c hc => h c (Or.inr hc)) k).2 hΨ


theorem markedLT_eq_clock {Clock Var : Type*} (c : Clock) (m : Marker) (a : NNReal) :
    (markedLT c m a : Judgement Clock Var) =
      .clock c (match m with | ○ => .lt | ● => .le) a := by cases m <;> rfl

theorem markedGT_eq_clock {Clock Var : Type*} (c : Clock) (m : Marker) (a : NNReal) :
    (markedGT c m a : Judgement Clock Var) =
      .clock c (match m with | ○ => .gt | ● => .ge) a := by cases m <;> rfl

end Judgement

namespace ConcreteRule
variable {Clock Var : Type*} [DecidableEq Clock]

set_option maxHeartbeats 12000000 in
-- Enumerating all ten rule families checks three evaluation relations per branch.
set_option linter.unusedSimpArgs false in
/-- Each expansion branch normalizes under the enclosing resets, preserving
satisfaction, non-predicate tests, and evaluated invariants. This includes
the `↑` form of `◇` with a zero lower timing bound. -/
theorem branch_normalization_properties
    {p : IntervalPredicate Clock Var} {R : ExpansionRule Clock Var}
    (hrule : ConcreteRule p R) {B : Judgement Clock Var} (hB : B ∈ R.branches)
    (Λ : ClockResetSet Clock) :
    ∃ Φ, TransitionForm.toTransitionForm? B = some Φ ∧
      ∀ (σ : FiniteSignal Var) (P : IntervalPartition σ.domain)
        (α : ClockValuation Clock) (k : Judgement.Position P),
        ((Φ.underReset Λ).Satisfies σ P α k ↔
          Judgement.Satisfies σ P (Λ.apply α) k B) ∧
        ((Φ.underReset Λ).NonPredicateSatisfies σ P α k ↔
          Judgement.NonPredicateSatisfies σ P (Λ.apply α) k B) ∧
        ((Φ.underReset Λ).evaluatedInvariant σ P α k ↔
          Judgement.EvaluatedInvariant σ P (Λ.apply α) k B) := by
  classical
  (cases hrule <;>
    simp only [ExpansionRule.plainAnd, ExpansionRule.plainOr,
      ExpansionRule.plainUntil, ExpansionRule.plainRelease,
      ExpansionRule.openEventually, ExpansionRule.openAlways,
      ExpansionRule.upperAlways, ExpansionRule.boundedAlways,
      ExpansionRule.upperEventually, ExpansionRule.boundedEventually,
      List.mem_cons, List.not_mem_nil, or_false, List.mem_append] at hB <;>
    (try split_ifs at hB) <;>
    (try simp only [List.mem_cons, List.not_mem_nil, or_false, or_assoc] at hB) <;>
    rcases hB with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) <;>
    (try simp only [ExpansionRule.upperAlways_defer, ExpansionRule.upperAlways_check,
      ExpansionRule.boundedAlways_defer, ExpansionRule.boundedAlways_check,
      ExpansionRule.boundedAlways_finish, ExpansionRule.upperEventually_defer,
      ExpansionRule.upperEventually_check, ExpansionRule.boundedEventually_defer,
      ExpansionRule.boundedEventually_check, ExpansionRule.boundedEventually_finish,
      Judgement.markedLT_eq_clock, Judgement.markedGT_eq_clock]) <;>
    (try simp only [TransitionForm.toTransitionForm?, Option.bind_some, Option.map_some,
      TransitionForm.unionNext, TransitionForm.ofState, TransitionForm.ofNextState,
      TransitionForm.nextPart_prependReset, TransitionForm.nextPart_union]) <;>
    refine ⟨_, rfl, ?_⟩ <;> intro σ P α k <;>
    by_cases hk : k.1 < P.size <;>
    simp only [TransitionForm.toTransitionForm?, TransitionForm.underReset,
      TransitionForm.prependReset, TransitionForm.union, TransitionForm.unionNext,
      TransitionForm.ofNextState, TransitionForm.ofState,
      StateForm.ofLocal, StateForm.ofClock, StateForm.empty, StateForm.union,
      TransitionForm.Satisfies, StateForm.Satisfies, ClockConstraint.Satisfies,
      Judgement.Satisfies, TransitionForm.NonPredicateSatisfies,
      StateForm.NonPredicateSatisfies, Judgement.NonPredicateSatisfies,
      TransitionForm.evaluatedInvariant, Judgement.EvaluatedInvariant,
      hk, dif_pos, dif_neg,
      ClockResetSet.apply_union_eq_comp, ClockResetSet.apply_empty,
      Set.mem_union, Set.mem_singleton_iff, Set.mem_empty_iff_false,
      forall_eq, forall_const, or_imp, forall_and, true_and, and_true,
      false_and, and_false, and_assoc, and_comm, and_left_comm,
      false_implies, implies_true, ↓reduceDIte, iff_self, and_self]

end ConcreteRule

/-- The proved properties of a transition-form representative of `Λ.Ψ`.
This interface retains literal current-predicate provenance, so it admits only
alpha-conversions compatible with that field. General alpha-converted source
and branch representatives are provided separately in `FreshNormalization`. -/
structure BranchRepresentation {Clock Var : Type*} (Λ : ClockResetSet Clock)
    (Ψ : Judgement Clock Var) (B : TransitionForm Clock Var) : Prop where
  currentPredicate_mem : ∀ q, Judgement.predicate q ∈ B.current.locals →
    q ∈ Ψ.currentPredicates
  evaluation : ∀ (σ : FiniteSignal Var) (P : IntervalPartition σ.domain)
    (α : ClockValuation Clock) (k : Judgement.Position P),
    (B.Satisfies σ P α k ↔ Judgement.Satisfies σ P (Λ.apply α) k Ψ) ∧
    (B.NonPredicateSatisfies σ P α k ↔
      Judgement.NonPredicateSatisfies σ P (Λ.apply α) k Ψ) ∧
    (B.evaluatedInvariant σ P α k ↔
      Judgement.EvaluatedInvariant σ P (Λ.apply α) k Ψ)

namespace BranchRepresentation
variable {Clock Var : Type*}

theorem mono {Λ₁ Λ₂ : ClockResetSet Clock} {Ψ : Judgement Clock Var}
    {B : TransitionForm Clock Var} (hsub : Λ₁.Subset Λ₂)
    (hfresh : Disjoint (Λ₂.clocks \ Λ₁.clocks) (Ψ.freeClocks \ Λ₁.clocks))
    (h : BranchRepresentation Λ₁ Ψ B) : BranchRepresentation Λ₂ Ψ B := by
  refine ⟨h.currentPredicate_mem, ?_⟩
  intro σ P α k
  have heq := Judgement.equivalent_of_fresh_reset_extension hsub hfresh σ P α k
  have hi := Judgement.evaluatedInvariant_congr_of_agree
    (ClockResetSet.apply_agree_of_fresh_extension hsub hfresh α) σ P k
  exact ⟨(h.evaluation σ P α k).1.trans heq.1,
    (h.evaluation σ P α k).2.1.trans heq.2,
    (h.evaluation σ P α k).2.2.trans hi⟩

end BranchRepresentation

namespace BranchTransitionForms

/-- A branch representation interface with all obligations proved. Existence
for every concrete branch is established by `ConcreteRule.branch_representation_exists`. -/
def concrete {Clock Var : Type*} : BranchTransitionForms Clock Var where
  relation := BranchRepresentation
  mono := BranchRepresentation.mono
  currentPredicate_mem := fun h hq => h.currentPredicate_mem _ hq
  satisfies_iff := fun h σ P α k => (h.evaluation σ P α k).1
  nonPredicateSatisfies_iff := fun h σ P α k => (h.evaluation σ P α k).2.1
  currentInvariant := by
    intro Ψ Λ B h σ P α k hk hinv
    have hi := ((h.evaluation σ P α k).2.2).2 hinv
    exact Judgement.setInvariant_of_evaluated σ P
      (B.current.resets.apply α) k hk _ hi.1
  nextInvariant := by
    intro Ψ Λ B h σ P α k hnext N hN hinv
    have hi := ((h.evaluation σ P α k).2.2).2 hinv
    have hk : k.1 < P.size := by omega
    simp only [TransitionForm.evaluatedInvariant, hN, dif_pos hk] at hi
    exact Judgement.setInvariant_of_evaluated σ P _ ⟨k.1 + 1, by omega⟩ hnext _ hi.2

end BranchTransitionForms

namespace ConcreteRule
variable {Clock Var : Type*} [DecidableEq Clock]

/-- The structural branch representative, including its enclosing resets. -/
noncomputable def branchTransitionForm
    {p : IntervalPredicate Clock Var} {R : ExpansionRule Clock Var}
    (hrule : ConcreteRule p R) {Ψ : Judgement Clock Var} (hΨ : Ψ ∈ R.branches)
    (Λ : ClockResetSet Clock) : TransitionForm Clock Var :=
  (Classical.choose (hrule.branch_has_transitionForm hΨ)).underReset Λ

/-- The concrete representative satisfies every obligation used by closure,
not just successful structural conversion. -/
theorem branchTransitionForm_represents
    {p : IntervalPredicate Clock Var} {R : ExpansionRule Clock Var}
    (hrule : ConcreteRule p R) {Ψ : Judgement Clock Var} (hΨ : Ψ ∈ R.branches)
    (Λ : ClockResetSet Clock) :
    BranchRepresentation Λ Ψ (hrule.branchTransitionForm hΨ Λ) := by
  obtain ⟨F, hF, heval⟩ := hrule.branch_normalization_properties hΨ Λ
  have heq : Classical.choose (hrule.branch_has_transitionForm hΨ) = F :=
    Option.some.inj ((Classical.choose_spec (hrule.branch_has_transitionForm hΨ)).symm.trans hF)
  unfold branchTransitionForm
  rw [heq]
  refine ⟨?_, heval⟩
  intro q hq
  exact (TransitionForm.toTransitionForm_currentPredicates Ψ hF q).1 hq

/-- Totality of the concrete interface on every registered rule branch and
any enclosing reset set. -/
theorem branch_representation_exists
    {p : IntervalPredicate Clock Var} {R : ExpansionRule Clock Var}
    (hrule : ConcreteRule p R) {Ψ : Judgement Clock Var} (hΨ : Ψ ∈ R.branches)
    (Λ : ClockResetSet Clock) :
    ∃ B, (BranchTransitionForms.concrete : BranchTransitionForms Clock Var).relation Λ Ψ B :=
  ⟨hrule.branchTransitionForm hΨ Λ, hrule.branchTransitionForm_represents hΨ Λ⟩

/-- Restore transition form after inserting an actual rule branch. The
compatibility hypothesis is the reset consistency and freshness
condition after any necessary alpha-conversion; it is not a semantic assumption. -/
theorem branch_normalization_in_context
    {p : IntervalPredicate Clock Var} {R : ExpansionRule Clock Var}
    (hrule : ConcreteRule p R) {Ψ : Judgement Clock Var} (hΨ : Ψ ∈ R.branches)
    (Φ : TransitionForm Clock Var)
    (hcompat : Φ.UnionCompatible (hrule.branchTransitionForm hΨ Φ.current.resets)) :
    ∃ Φhat : TransitionForm Clock Var,
      Φhat = Φ.union (hrule.branchTransitionForm hΨ Φ.current.resets) ∧
      (Φ ⊑ Φhat) ∧ (hrule.branchTransitionForm hΨ Φ.current.resets ⊑ Φhat) ∧
      ∀ (σ : FiniteSignal Var) (P : IntervalPartition σ.domain)
        (α : ClockValuation Clock) (k : Judgement.Position P),
        Φhat.Satisfies σ P α k ↔
          Φ.Satisfies σ P α k ∧
            Judgement.Satisfies σ P (Φ.current.resets.apply α) k Ψ := by
  refine ⟨_, rfl, hcompat.leftSubsumed, hcompat.rightSubsumed, ?_⟩
  intro σ P α k
  rw [TransitionForm.satisfies_union_iff _ _ hcompat.leftSubsumed
    hcompat.rightSubsumed hcompat.currentConsistent hcompat.nextConsistent]
  exact and_congr Iff.rfl
    ((hrule.branchTransitionForm_represents hΨ Φ.current.resets).evaluation σ P α k).1

end ConcreteRule

namespace BranchTransitionForms
variable {Clock Var : Type*} [DecidableEq Clock]

/-- One-step invariant preservation with the proved branch representation
interface, without an externally supplied `BranchTransitionForms` parameter. -/
theorem concrete_expansion_preservesInvariantAt
    {p : IntervalPredicate Clock Var} {σ : FiniteSignal Var}
    {Φ Φ' : TransitionForm Clock Var}
    (hexp : (concrete : BranchTransitionForms Clock Var).expansionRules.PExpansion p Φ Φ')
    (P : IntervalPartition σ.domain) (α : ClockValuation Clock)
    (k : Judgement.Position P) (hk : k.1 < P.size)
    (hΦ' : Φ'.NonPredicateSatisfies σ P α k) (hinv : Φ.InvariantAt P α k hk) :
    Φ'.InvariantAt P α k hk :=
  concrete.expansion_preservesInvariantAt hexp P α k hk hΦ' hinv

/-- Closure invariant preservation using the same concrete interface. This
is conditional on being a closure; it does not assert existence of a closure. -/
theorem concrete_closure_preservesInvariantAt
    {σ : FiniteSignal Var} {Φ Φc : TransitionForm Clock Var}
    (hclosure : (concrete : BranchTransitionForms Clock Var).expansionRules.IsClosure Φ Φc)
    (P : IntervalPartition σ.domain) (α : ClockValuation Clock)
    (k : Judgement.Position P) (hk : k.1 < P.size)
    (hΦc : Φc.NonPredicateSatisfies σ P α k) (hinv : Φ.InvariantAt P α k hk) :
    Φc.InvariantAt P α k hk :=
  concrete.closure_preservesInvariantAt hclosure P α k hk hΦc hinv

end BranchTransitionForms

end STLTableau
